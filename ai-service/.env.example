# Python AI service
AI_HOST=127.0.0.1
AI_PORT=8000
# Optional: shared secret the backend sends in X-Service-Token (set the same value as AI_SERVICE_TOKEN in backend/.env)
AI_SERVICE_TOKEN=
# Optional: Gemini is used ONLY to word explanations. Leave empty to use deterministic text.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Comma-separated directories the market pipeline may read CSV files from (defaults: OS temp dir + ../data)
MARKET_ALLOWED_DIRS=
