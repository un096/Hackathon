# ── Database (PostgreSQL 14+) ──
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/talentbridge_db"

# ── Auth ── use a long random string (32+ chars). Never commit the real value.
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
JWT_EXPIRES_IN="8h"

# ── Server ──
PORT=5000
NODE_ENV=development
# comma-separated list of allowed browser origins
FRONTEND_URL=http://localhost:5173

# ── Python AI service (optional; deterministic fallbacks are used when it is offline) ──
AI_SERVICE_URL=http://localhost:8000
# Optional shared secret; set the same value in ai-service/.env
AI_SERVICE_TOKEN=

# ── Optional overrides ──
# MARKET_SAMPLE_CSV=../data/market_sample_tech_jobs.csv
# SEED_USE_AI=0   # force the Node pipeline during seeding
