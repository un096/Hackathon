{
  "name": "talentbridge-backend",
  "version": "1.0.0",
  "description": "TalentBridge AI - REST API (Express + Prisma)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:reset": "prisma migrate reset --force && node prisma/seed.js",
    "setup": "prisma generate && prisma migrate deploy && node prisma/seed.js",
    "test:e2e": "node tests/e2e.test.js"
  },
  "dependencies": {
    "@prisma/client": "7.10.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.23.8",
    "@prisma/adapter-pg": "7.10.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prisma": "7.10.1"
  },
  "engines": {
    "node": ">=20.19"
  }
}